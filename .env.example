# Razorpay Test Mode Credentials
# Get yours from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret

# LLM Provider Credentials (Optional: Leave empty for built-in Mock ReAct Brain)
# Set ANTHROPIC_API_KEY to use Claude 3.5 Sonnet
ANTHROPIC_API_KEY=
# Or set OPENAI_API_KEY to use GPT-4o
OPENAI_API_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development
